PORT=3000
# Connection string do Postgres do Supabase (Project Settings > Database > Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<SUA-SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# Use DATABASE_SSL=false só se for um Postgres local sem SSL
DATABASE_SSL=true
# Segredo que assina o JWT. Gere um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo
# Origem do front-end liberada no CORS
FRONTEND_URL=http://localhost:5173
